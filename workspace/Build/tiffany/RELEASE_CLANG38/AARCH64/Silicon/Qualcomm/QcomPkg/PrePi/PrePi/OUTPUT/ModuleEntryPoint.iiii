



.text
.align 3

.set CTRL_SPAN_BIT, (1 << 23)

.extern CEntryPoint
.extern SecondaryCEntryPoint

.extern ArmEnableInstructionCache
.extern ArmEnableDataCache
.extern ArmInvalidateTlb

.global _ModuleEntryPoint ; .type _ModuleEntryPoint, %function
.global SecondaryCpuEntry ; .type SecondaryCpuEntry, %function

.global _StackBase
.global _StackSize

_StackBase:
  .quad 0x9FF90000

_StackSize:
  .quad 0x00040000

_ModuleEntryPoint:
  mov x10, 0x83300000
  str x0, [x10]

  mov x0, #0
  mov x1, #0


  bl ArmDisableInterrupts


  bl ArmDisableCachesAndMmu


  bl ArmInvalidateInstructionCache


  bl ArmInvalidateTlb

  mrs x0, sctlr_el1
  orr x0, x0, #CTRL_SPAN_BIT
  msr sctlr_el1, x0

_SetupExceptionVector:
  ldr x0, =0x9ff8c000
  bl ArmWriteVBar

  mrs x4, mpidr_el1
  and x4, x4, #0xFFFF
  lsr x4, x4, #8
  cbnz x4, SecondaryCpuEntry

  ldr x1, dead
  add x2, x0, #0x800
  mov x3, x0

_FillVectors:
  stp x1, x1, [x3], #16
  cmp x3, x2
  b.lt _FillVectors

_DonNotTrap_VFP_SIMD:
  mrs x0, CPACR_EL1

  orr x0, x0, #0x300000
  msr CPACR_EL1, x0
  isb sy

_SetupPrimaryCoreStack:
  ldr x0, _StackBase
  ldr x1, _StackSize


  add x2, x0, x1
  mov x3, x0

  mov v4.d[0], xzr
  mov v4.d[1], xzr
  mov v5.16b, v4.16b
  mov v6.16b, v4.16b
  mov v7.16b, v4.16b

_ClearStack:

  st4 {v4.16b, v5.16b, v6.16b, v7.16b}, [x3], #64
  cmp x3, x2
  b.lt _ClearStack

  add sp, x2, xzr

_EnableCache:
  bl ArmInvalidateDataCache
  bl ArmEnableInstructionCache
  bl ArmEnableDataCache

_PrepareArguments:

  ldr x0, _StackBase
  ldr x1, _StackSize

  bl CEntryPoint

.align 3
dead:
  b dead

SecondaryCpuEntry:

  mov x19, x4

  mov x5, #0x8
  sub x4, x5, x4

  ubfiz x2, x4, #15, #8

_SetupSecondaryCoreStack:
  ldr x3, _StackBase

  add x2, x3, x2
  sub x3, x2, #0x8000

  mov x4, xzr
  mov x5, xzr

_ClearStackSecondary:

  stp x4, x5, [x3], #16
  cmp x3, x2
  b.lt _ClearStackSecondary

  add sp, x2, xzr

  bl ArmInvalidateDataCache


  mov x0, x19
  bl SecondaryCEntryPoint

secondarydead:
  wfe
  b secondarydead
