$(OUTPUT_DIR)/UefiShellLevel2CommandsLib.lib : $(OBJECT_FILES_LIST)
	$(RM) /home/hina/edk2-msm/workspace/Build/tiffany/RELEASE_CLANG38/AARCH64/ShellPkg/Library/UefiShellLevel2CommandsLib/UefiShellLevel2CommandsLib/OUTPUT/UefiShellLevel2CommandsLib.lib
