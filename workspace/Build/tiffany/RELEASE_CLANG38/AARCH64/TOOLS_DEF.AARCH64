PLATFORM_FAMILY = GCC
PLATFORM_FLAGS = 

PP_BUILDRULEORDER = nasm asm Asm ASM S s nasmb asm16
PP_FAMILY = GCC
PP_FLAGS = -E -x assembler-with-cpp -include AutoGen.h -DOPENSBI_EXTERNAL_SBI_TYPES=OpensbiTypes.h -target aarch64-linux-gnu $(ARCHCC_FLAGS) $(PLATFORM_FLAGS)
PP_PATH = clang

